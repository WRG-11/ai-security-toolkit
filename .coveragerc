[run]
# Why the scope is wide: this used to measure `tools` only -- 1362 statements
# out of a ~14,900-line repo. The report said 16%, but it was a 16% of one
# fifth of the code: labs/ (52 files, most of the codebase) and
# huggingface-space/ were outside measurement entirely, so a regression there
# could not move the number at all.
#
# Measured 2026-07-29 with this scope: 3663 statements, 35%. The number went
# UP not because tests were added but because the denominator became honest --
# many files under labs/ count as covered simply by being imported. That is
# still the right denominator: you cannot see what is untested until it is
# inside the measured set.
source =
    tools
    labs
    huggingface-space
branch = True
omit =
    tests/*
    .venv/*
    */__pycache__/*

[report]
show_missing = True
# A floor below the measured figure: an ordinary PR adding a lightly-covered
# path should not fail the build, but a real regression should. Ratchet upward
# as coverage grows; do not lower it to accommodate new untested code.
#
# Note: the value 15 belonged to the narrow `tools`-only scope and stopped
# meaning anything the moment the scope widened. The value 30 was set against
# a measured 35% -- but the tests added in the same round took the real figure
# to 51% and nobody moved the floor, so it sat 21 points below reality and
# would have waved through a very large regression. It happened again: 45
# was set at some point against a lower figure, and by 2026-08-03 the real
# number had reached 53% with the floor never moved -- same drift, smaller
# gap. Ratcheted to 50 (a 3-point margin below the measured 53%, not the
# ~20-point gaps this file has drifted to twice now).
#
# The measured percentage is deliberately NOT repeated in prose anywhere. It
# moves with every commit and cannot be resolved without running the suite;
# README stamps THIS number instead, because this is the one that is enforced.
fail_under = 50
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
    if TYPE_CHECKING:
